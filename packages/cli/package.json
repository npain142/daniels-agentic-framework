{
  "name": "@daniels-agent-framework/cli",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "daf": "./dist/cli.js"
  },
  "exports": {
    "./*": "./dist/*.js"
  },
  "files": [
    "dist",
    "bundled-templates"
  ],
  "scripts": {
    "build": "tsc && node scripts/bundle-templates.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0"
  }
}
