{
  "name": "@daniels-agent-framework/cli",
  "version": "0.1.0",
  "description": "Daniels Agentic Framework (DAF) — machine bootstrap and project health (`daf onboard`, `daf health`).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "daf": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./*": "./dist/*.js"
  },
  "files": [
    "dist",
    "bundled-templates"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/daniel-feustel/daniels-agent-framework.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "daf",
    "agent",
    "cursor",
    "ai",
    "scaffold"
  ],
  "scripts": {
    "build": "tsc && node scripts/bundle-templates.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0"
  }
}
